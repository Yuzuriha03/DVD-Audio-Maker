# DVD-Audio Maker configuration for native Windows.
# Format: KEY=VALUE. Use absolute Windows paths.

DVDA_SRC="D:/Music/MyAlbums"
DVDA_FINAL_DIR="D:/DVD_Output"
DVDA_BUILD_DIR="D:/DVD_Output/_work"

DVDA_TITLE="My DVD-Audio Collection"
DVDA_ISO_PREFIX="MyCollection"
DVDA_MAX_DISCS="2"
DVDA_GROUP_TRACK_LIMIT="99"
DVDA_DISC_BYTES=""

DVDA_MLP_SOURCE="surcode-batch"
DVDA_MLP_EXTERNAL_DIR=""
DVDA_MLP_BATCH_TEMP_DIR="D:/dvda-surcode/temp"
DVDA_MLP_BATCH_OUTPUT_DIR="D:/dvda-surcode/output"
DVDA_MLP_METADATA_CONTEXT=""
DVDA_MLP_SURCODE_SAMPLE_RATE="48000"
DVDA_MLP_SURCODE_BITS="24"

DVDA_MENU="off"
DVDA_MENU_STILLPICS="on"
DVDA_MENU_TRACKS_PER_PAGE="12"
DVDA_MENU_INDEX_MIN_ALBUMS="4"
DVDA_MENU_COVER_DIM="35"
DVDA_MENU_FONT=""
DVDA_MENU_FONT_JP=""
DVDA_MENU_FONT_KR=""

DVDA_AUTHOR=""
DVDA_MKISOFS=""
DVDA_AUTHOR_SRC=""
# GUI always uses the bundled x64 media libraries. Explicit external paths are
# retained only for developer CLI comparisons with earlier versions.
DVDA_FFMPEG="builtin:media"
DVDA_FFPROBE="builtin:probe"
DVDA_METAFLAC="metaflac"
DVDA_LOSS_ERROR_S="0.05"
DVDA_LOSS_WARN_S="0.005"
