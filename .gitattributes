# Text files use CRLF because this project is built and run on Windows/MSVC.
# Git keeps the working tree consistent on checkout. Unix-shell scripts may need
# conversion to LF before direct execution in WSL or another Unix environment.

* text=auto eol=crlf

# Source, configuration, scripts, and documentation.
*.py           text eol=crlf
*.sh           text eol=crlf
*.md           text eol=crlf
*.txt          text eol=crlf
*.rs           text eol=crlf
*.c            text eol=crlf
*.h            text eol=crlf
*.cc           text eol=crlf
*.cpp          text eol=crlf
*.cxx          text eol=crlf
*.hh           text eol=crlf
*.hpp          text eol=crlf
*.toml         text eol=crlf
*.json         text eol=crlf
*.xml          text eol=crlf
*.yml          text eol=crlf
*.yaml         text eol=crlf
*.csv          text eol=crlf
*.tsv          text eol=crlf
*.lock         text eol=crlf
*.l            text eol=crlf
*.y            text eol=crlf
LICENSE        text eol=crlf
.gitignore     text eol=crlf
.gitattributes text eol=crlf

# Windows command files are explicitly CRLF for cmd.exe parsing.
*.bat          text eol=crlf
*.cmd          text eol=crlf

# windres inputs are embedded byte-for-byte in the executable. Keep them
# binary so checkout cannot change the bytes used by a reproducible build.
*.manifest     -text
*.rc           -text

# Media, archives, generated binaries, and other non-text data.
*.flac         binary
*.wav          binary
*.m4a          binary
*.mlp          binary
*.iso          binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.zip          binary
*.gz           binary
*.7z           binary
*.bz2          binary
*.xz           binary
*.exe          binary
*.dll          binary
*.pdb          binary
*.lib          binary
*.a            binary
*.obj          binary
*.o            binary
*.res          binary
*.ico          binary
*.bmp          binary
*.tif          binary
*.tiff         binary
*.ifo          binary
