{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust GUI (debug x64)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "Rust: build workspace x64",
      "program": "${workspaceFolder}/rust/target/x86_64-pc-windows-gnu/debug/dvda-desktop.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--profile",
        "${workspaceFolder}/settings.local.json"
      ],
      "terminal": "integrated",
      "env": {
        "DVDA_MEDIA_NATIVE_DIR": "${workspaceFolder}/build/media-native-shared",
        "DVDA_IMAGE_NATIVE_DIR": "${workspaceFolder}/build/image-native",
        "DVDA_FORMATS_NATIVE_DIR": "${workspaceFolder}/build/formats-native",
        "DVDA_DISC_VERIFY_LIBRARY": "${workspaceFolder}/build/menu-native/dvda-disc-verify.dll",
        "DVDA_ENCODER_LIBRARY": "${workspaceFolder}/native/mlp-encoder/win-x64/mlp_encoder.dll"
      }
    },
    {
      "name": "Rust CLI (debug x64)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "Rust: build workspace x64",
      "program": "${workspaceFolder}/rust/target/x86_64-pc-windows-gnu/debug/dvda-cli.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "build",
        "--profile",
        "${workspaceFolder}/settings.local.json",
        "--dry-run"
      ],
      "terminal": "integrated",
      "env": {
        "DVDA_MEDIA_NATIVE_DIR": "${workspaceFolder}/build/media-native-shared",
        "DVDA_IMAGE_NATIVE_DIR": "${workspaceFolder}/build/image-native",
        "DVDA_FORMATS_NATIVE_DIR": "${workspaceFolder}/build/formats-native",
        "DVDA_DISC_VERIFY_LIBRARY": "${workspaceFolder}/build/menu-native/dvda-disc-verify.dll",
        "DVDA_ENCODER_LIBRARY": "${workspaceFolder}/native/mlp-encoder/win-x64/mlp_encoder.dll"
      }
    }
  ]
}
