<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dvda</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DvdaMaker.Building\DvdaMaker.Building.csproj" />
    <ProjectReference Include="..\DvdaMaker.Configuration\DvdaMaker.Configuration.csproj" />
    <ProjectReference Include="..\DvdaMaker.Preparation\DvdaMaker.Preparation.csproj" />
  </ItemGroup>
  <!-- Packaged CLI and GUI share the same desktop runtime assets. -->
  <ItemGroup Condition="'$(ShareDesktopRuntime)' == 'true'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
</Project>
